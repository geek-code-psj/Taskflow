# ============================================================
# apps/api — Environment Variables
# Copy these into Railway dashboard → API service → Variables
# ============================================================

# ── Database (set by Railway auto-reference) ──────────────────
# When you add a PostgreSQL plugin in Railway, set:
DATABASE_URL=${{Postgres.DATABASE_URL}}

# If using PgBouncer (recommended for 10,000+ users), point to PgBouncer instead:
# DATABASE_URL=${{PgBouncer.DATABASE_URL}}

# Database app role password (use a strong random value)
DB_APP_PASSWORD=generate_strong_random_password_here

# ── Redis (add Redis plugin in Railway, then reference) ───────
REDIS_URL=${{Redis.REDIS_URL}}

# ── JWT Secrets (generate with: openssl rand -hex 64) ────────
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_HEX_SECRET

# ── CORS (set to your Railway frontend URL) ───────────────────
# Example: FRONTEND_URL=https://taskflow-web.up.railway.app
FRONTEND_URL=${{web.RAILWAY_PUBLIC_DOMAIN}}

# ── Runtime ───────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# ── Cluster workers (optional: defaults to CPU count) ─────────
# WEB_CONCURRENCY=4
